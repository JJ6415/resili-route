# ResiliRoute v3.3 Environment Template
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
EKISPERT_API_KEY=YOUR_EKISPERT_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-flash-latest

# Google Cloud & Vertex AI Configuration
GCP_PROJECT_ID=your-gcp-project-id
VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=asia-northeast1

# Cache Backend: "local" ($0 cost) or "vertex_ai" (Enterprise Context Caching)
CACHE_BACKEND=vertex_ai

# Optional Slack Integration Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Server Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=false
